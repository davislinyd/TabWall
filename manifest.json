{
  "manifest_version": 3,
  "name": "TabWall",
  "version": "2.46.6",
  "description": "Arrange saved tabs and Tab Groups on a spatial canvas. Search, stack, restore—data stays on your device.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "tabGroups",
    "alarms",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["parkSearchQuery.js", "quickSearch.js", "aiUiCore.js", "aiPanel.js", "content.js", "pageAnnotate.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TabWall",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "park.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "park.html",
        "park.css",
        "park.js",
        "backupBuild.js",
        "quickSearch.js",
        "parkSearchQuery.js",
        "parkSearchUi.js",
        "parkMediaUi.js",
        "parkCanvasGeometry.js",
        "parkCanvasRender.js",
        "parkStickerUi.js",
        "parkImportExport.js",
        "parkSettingsUi.js",
        "canvasStore.js",
        "mediaDb.js",
        "noteMedia.js",
        "parkWallpaper.js",
        "parkI18n.js",
        "parkCanvasInteraction.js",
        "parkCanvasChrome.js",
        "parkListUi.js",
        "parkWorkspaceUi.js",
        "parkReminderUi.js",
        "parkAppHelpers.js",
        "parkHistory.js",
        "aiUiCore.js",
        "parkAiUi.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "save-tab": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Park current tab"
    },
    "save-keep": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Park current tab or Tab Group without closing it"
    },
    "save-group": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Park current Tab Group"
    },
    "toggle-park": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Toggle TabWall overlay"
    },
    "open-ai": {
      "description": "Open TabWall AI panel"
    },
    "toggle-annotate": {
      "description": "Toggle TabWall drawing layer"
    }
  }
}
